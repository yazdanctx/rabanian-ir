---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getOrderedCollection } from '../content/ordered';
import { COPY } from '../site';

/*
 * The About section's photo strip: Amin at work, in the order of
 * src/content/gallery.json (images: src/assets/gallery/<id>.*). It spans the
 * full window width; every photo is 200px tall (280px from md:) at its own
 * aspect ratio.
 *
 * With motion allowed it scrolls itself in an endless loop: the motion script
 * (src/scripts/motion.ts) appends an inert, aria-hidden copy of the photos and
 * sets `data-looping`, and the CSS below slides the row. It pauses while
 * hovered, touched or focused. Under reduced motion or with no JS it is a row
 * to swipe.
 */
const photos = await getOrderedCollection('gallery');
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
function imageFor(id: string): ImageMetadata {
  const matches = Object.entries(files).filter(([path]) => path.replace(/^.*\/|\.\w+$/g, '') === id);
  if (matches.length !== 1) {
    throw new Error(`Gallery photo "${id}": expected one src/assets/gallery/${id}.* file, found ${matches.length}`);
  }
  return matches[0][1].default;
}
const SMALL = 200;
const LARGE = 280;
---

<div data-gallery-frame data-reveal class="mx-[calc(50%-50vw)] mb-8">
  <ul
    data-gallery
    data-autoscroll
    aria-label={COPY.about.galleryLabel}
    tabindex="0"
    class="gallery flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 pb-1 focus-visible:outline-2 focus-visible:outline-primary"
  >
    {
      photos.map(({ id, data }) => {
        const image = imageFor(id);
        const ratio = image.width / image.height;
        const small = Math.round(SMALL * ratio);
        const large = Math.round(LARGE * ratio);
        return (
          <li class="flex-none snap-start">
            <Picture
              src={image}
              alt={data.alt}
              formats={['avif', 'webp']}
              widths={[small, large, large * 2]}
              sizes={`(min-width: 768px) ${large}px, ${small}px`}
              width={large}
              height={LARGE}
              loading="lazy"
              decoding="async"
              class="h-50 w-auto rounded-card border border-line object-cover md:h-70"
            />
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .gallery {
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }

  .gallery::-webkit-scrollbar {
    display: none;
  }

  /*
   * The loop. The row holds the photos twice, each followed by its gap as a
   * margin, so half the row is exactly one set: sliding it by 50% puts the
   * copies where the photos were and the loop restarts unseen. RTL: the next
   * photo is on the left, so the row moves right. The frame clips it.
   */
  @keyframes gallery-loop {
    to {
      transform: translateX(50%);
    }
  }

  [data-gallery-frame]:has(> [data-looping]) {
    overflow: hidden;
  }

  .gallery[data-looping] {
    width: max-content;
    gap: 0;
    padding-inline: 0;
    overflow: visible;
    scroll-snap-type: none;
    /* About 30–45px a second, depending on the photos' height. */
    animation: gallery-loop calc(var(--loop-count) * 9s) linear infinite;
  }

  .gallery[data-looping] > :global(*) {
    margin-inline-end: 0.75rem;
  }

  .gallery[data-looping]:is(:hover, :focus-within, :active) {
    animation-play-state: paused;
  }
</style>
