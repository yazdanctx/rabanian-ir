---
/*
 * Section eyebrow: an 18×2px `primary` bar, then 12px/500 text in
 * `primary-text`. Pass `class` to recolour the text (e.g. on the dark CTA).
 */
interface Props {
  class?: string;
}

const { class: className = 'text-primary-text' } = Astro.props;
---

<p
  class:list={[
    'flex items-center gap-2 text-xs font-medium before:h-0.5 before:w-4.5 before:rounded-full before:bg-primary',
    className,
  ]}
>
  <slot />
</p>
