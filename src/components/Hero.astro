---
import { getOrderedCollection } from '../content/ordered';
import { COPY, SITE } from '../site';
import Dotted from './Dotted.astro';
import Icon from './Icon.astro';
import ProfilePhoto from './ProfilePhoto.astro';
import Section from './Section.astro';

const stats = await getOrderedCollection('stats');
const buttonClasses =
  'flex flex-1 items-center justify-center gap-1.5 rounded-btn px-4 py-3.25 text-sm font-semibold lift';
---

<Section id="top" class="pt-10 text-center md:pt-14" stagger="load">
  <div
    data-reveal
    data-badge
    class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-medium text-muted"
  >
    <span aria-hidden="true" class="pulse-dot size-1.75 rounded-full bg-status"></span>
    <Dotted text={SITE.badge} />
  </div>
  <h1 data-reveal class="mt-5 mb-2 text-[44px]/[1.1] font-bold tracking-[-0.03em] md:text-[56px]/[1.1]">{SITE.name}</h1>
  <p
    data-reveal
    class="mx-auto mb-3 w-fit bg-[linear-gradient(90deg,color-mix(in_oklab,var(--color-primary-text)_65%,var(--color-ink)),color-mix(in_oklab,var(--color-primary)_75%,white)_50%,color-mix(in_oklab,var(--color-primary-text)_65%,var(--color-ink)))] bg-clip-text text-lg font-semibold text-primary-text [-webkit-text-fill-color:transparent] [mask-image:linear-gradient(to_bottom,#000_40%,rgb(0_0_0/0.65))] md:text-xl"
  >
    {SITE.tagline}
  </p>
  <p data-reveal class="mx-auto max-w-[30rem] text-[15px]/[1.9] text-muted">{SITE.lead}</p>

  <div data-reveal><ProfilePhoto /></div>

  <div data-reveal class="mb-5.5 flex gap-2.5">
    <a href="#courses" class:list={[buttonClasses, 'bg-primary text-on-primary hover:bg-primary-hover']}>
      {COPY.hero.coursesButton}<Icon name="chevron" size={16} />
    </a>
    <a href="#tools" class:list={[buttonClasses, 'border border-line bg-bg shadow-card hover:border-primary']}>
      {COPY.hero.toolsButton}
    </a>
  </div>

  <ul data-reveal data-stats class="grid grid-cols-3 gap-2.5">
    {
      stats.map(({ data }) => (
        <li class="rounded-card border border-line bg-(--card) px-2.5 py-4 text-center">
          <b
            data-value
            class="mx-auto block w-fit bg-[linear-gradient(100deg,var(--color-ink)_25%,color-mix(in_oklab,var(--color-muted)_75%,white)_50%,var(--color-ink)_75%)] bg-clip-text text-[26px]/tight font-bold tracking-[-0.02em] text-ink [-webkit-text-fill-color:transparent]"
          >
            {data.value}
          </b>{' '}
          <span class="text-[11.5px] text-muted">{data.label}</span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* Ambient, like the Brands loop (spec: Motion); static under reduced motion. */
  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }

  .pulse-dot {
    animation: pulse-dot 3s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse-dot {
      animation: none;
    }
  }
</style>
