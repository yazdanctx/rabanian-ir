---
import { COPY, LINKS } from '../site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  /** Extra classes, e.g. the HTML Editor's wider column. */
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  class:list={['mx-auto flex max-w-page items-center justify-between px-5 pt-4.5', className]}
>
  <Logo />
  <a
    href={LINKS.support}
    aria-label={COPY.topBar.supportLabel}
    class="grid size-9 place-items-center rounded-[11px] border border-line bg-surface text-ink lift hover:border-primary hover:text-primary-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
  >
    <Icon name="telegram" size={17} />
  </a>
</header>
