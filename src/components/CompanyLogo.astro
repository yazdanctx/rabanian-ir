---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/*
 * A company's logo in a rounded tile, for Brands and résumé Experiences.
 * Logos live in src/assets/logos/<id>.<png|jpg|webp|svg> (sources in the README
 * there); `id` is the Brand/Experience id, which the two collections share.
 * Decorative (alt=""): the company's name is always next to it.
 */
interface Props {
  id: string;
  /** Tile size in px. */
  size: number;
  class?: string;
}

const { id, size, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.{png,jpg,webp,svg}', {
  eager: true,
});
const matches = Object.entries(files).filter(([path]) => path.replace(/^.*\/|\.\w+$/g, '') === id);
if (matches.length !== 1) {
  throw new Error(
    matches.length
      ? `Several logos for "${id}" in src/assets/logos/: keep one`
      : `No logo for "${id}": add src/assets/logos/${id}.<png|svg>`,
  );
}
const logo = matches[0][1].default;
---

<span
  data-logo
  class:list={['block shrink-0 overflow-hidden rounded-[10px] border border-line bg-bg', className]}
  style={{ width: `${size}px`, height: `${size}px` }}
>
  <Image
    src={logo}
    alt=""
    width={size}
    height={size}
    {...logo.format === 'svg' ? { format: 'svg' } : { format: 'webp', densities: [1, 2, 3] }}
    loading="lazy"
    decoding="async"
    class="size-full object-contain"
  />
</span>
