---
import Eyebrow from './Eyebrow.astro';

/*
 * One landing-page section: a full-width band holding the centered ~680px
 * column. Bands meet in a few ways: a band may rise into the one above along
 * a diagonal (`top="slash"`), a white band may bulge down into the gray one
 * below (`sag` + `top="under"`), a band may fade to white into the next
 * (`fade`), or two meet edge to edge, with or without a hairline (`top="rule"`).
 * Slashes and curves overlap the neighbour by their height, 32px (64px from
 * md:): a slash is a clip-path on the rising band, a curve the sagging band's
 * corner radii. The column pads 20px inline and 48px on top (64px
 * from md:); at the bottom it adds a curve's height, so no curve ever covers
 * content. Children go in the default slot.
 *
 *   <Section id="tools" eyebrow="جعبه‌ابزار" title="ابزارها" tone="gray" top="under">…</Section>
 *
 * Props (all optional):
 * - id:      anchor id on the <section> (e.g. "courses", "tools").
 * - eyebrow: small label above the title (rendered only with it).
 * - title:   the section's h2.
 * - tone:    the band's background. "white" (default) and "gray" alternate
 *            down the page; cards inside follow the tone through two
 *            variables: `bg-(--card)` is gray on white and white on gray, and
 *            `--tone` is the band's own color (e.g. for rings that cut a line).
 *            The page's one dark block is the footer (Footer.astro), not a band.
 * - top:     how the band meets the one above. "flat" (default): edge to
 *            edge. "rule": edge to edge under a 1px `line` hairline (for two
 *            bands of one tone). "slash": it rises into the band above along a
 *            straight diagonal, «/» — low at the left, full height at the right.
 *            "under": it slides under the band above, which must `sag` into
 *            it, and pads its top by the curve.
 * - sag:     the band's bottom bulges down into the next one (a half-ellipse),
 *            painting over it; the next band takes `top="under"`.
 * - fade:    the band's color fades to white over its last 10rem, so a white
 *            band below meets it `top="flat"` with no seam.
 * - class:   extra classes on the inner column, e.g. "pt-7" to change padding.
 * - stagger: "load" makes the column a motion group (`data-stagger="load"`)
 *            whose `data-reveal` children reveal 60ms apart on page load
 *            (src/scripts/motion.ts); the Hero uses it.
 *
 * The header is always a `data-reveal`; mark other content blocks
 * with `data-reveal` (and lists with `data-stagger`) where they are written.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  tone?: 'white' | 'gray';
  top?: 'flat' | 'rule' | 'slash' | 'under';
  sag?: boolean;
  fade?: boolean;
  class?: string;
  stagger?: 'load';
}

const {
  id,
  eyebrow,
  title,
  tone = 'white',
  top = 'flat',
  sag = false,
  fade = false,
  class: className,
  stagger,
} = Astro.props;
const tones = {
  white: 'bg-bg [--card:var(--color-surface)] [--tone:var(--color-bg)]',
  gray: 'bg-surface [--card:var(--color-bg)] [--tone:var(--color-surface)]',
};
/** Each top edge; slashes and curves overlap by their height (2rem, 4rem from md:). */
const tops = {
  flat: '',
  rule: 'border-t border-line',
  slash:
    '-mt-8 [clip-path:polygon(0_2rem,100%_0,100%_100%,0_100%)] md:-mt-16 md:[clip-path:polygon(0_4rem,100%_0,100%_100%,0_100%)]',
  under: '-mt-8 md:-mt-16',
};
/** Top padding: 48px (64px from md:), plus room for the edge where it overlaps. */
const topPadding = {
  flat: 'pt-12 md:pt-16',
  rule: 'pt-12 md:pt-16',
  slash: 'pt-16 md:pt-24',
  under: 'pt-20 md:pt-32',
};
---

<section
  id={id}
  data-tone={tone}
  class:list={[
    'relative',
    tones[tone],
    tops[top],
    sag && 'z-10 rounded-b-[50%_2rem] md:rounded-b-[50%_4rem]',
    fade && 'bg-[linear-gradient(to_bottom,var(--color-surface)_calc(100%-10rem),var(--color-bg))]',
  ]}
>
  <div
    class:list={[
      'relative mx-auto max-w-page px-5 pb-20 md:pb-32',
      topPadding[top],
      className,
    ]}
    data-stagger={stagger}
  >
    {
      title && (
        <header data-reveal class="mb-6">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          <h2 class="mt-2 text-2xl/snug font-bold tracking-[-0.02em] md:text-[32px]/snug">{title}</h2>
        </header>
      )
    }
    <slot />
  </div>
</section>
