---
import Eyebrow from './Eyebrow.astro';

/*
 * One landing-page section: a full-width band holding the centered ~680px
 * column. Bands meet in a few ways: a band may rise into the one above along
 * a curve (`top="sweep"`), lie over the one below with a curved foot
 * (`bottom="sweep"`), or meet it edge to edge, with or without a hairline
 * (`top="rule"`). Sweeps overlap the neighbour by their height, 32px (64px
 * from md:), drawn as a corner radius one band wide. The
 * column pads 20px inline and 48px on top (64px from md:, plus room for an
 * overlapping edge); at the bottom it adds a curve's height, so no edge ever
 * covers content. Children go in the default slot.
 *
 *   <Section id="tools" eyebrow="جعبه‌ابزار" title="ابزارها" tone="gray" top="sweep" bottom="sweep">…</Section>
 *
 * Props (all optional):
 * - id:      anchor id on the <section> (e.g. "courses", "tools").
 * - eyebrow: small label above the title (rendered only with it).
 * - title:   the section's h2.
 * - tone:    the band's background. "white" (default) and "gray" alternate
 *            down the page; cards inside follow the tone through two
 *            variables: `bg-(--card)` is gray on white and white on gray, and
 *            `--tone` is the band's own color (e.g. for rings that cut a line).
 *            The page's one dark block is the footer (Footer.astro), not a band.
 * - top:     how the band meets the one above. "flat" (default): edge to
 *            edge. "rule": edge to edge under a 1px `line` hairline (for two
 *            bands of one tone). "sweep": it rises along a quarter-ellipse one band wide,
 *            bending at the left and level at the right. "under": it tucks
 *            under the band above, whose `bottom` overlaps it.
 * - bottom:  how the band meets the one below. "flat" (default). "sweep": the
 *            top sweep turned 180° — bending at the right — laid over the next
 *            band, which takes `top="under"`. With a sweep at both ends both
 *            edges rise to the right, so the band flows like a wave.
 * - gradient: a smooth, subtle gray gradient for a gray band, top to bottom,
 *            from `surface` to a slightly deeper gray (40% `surface`, 60%
 *            `line`); it never reaches white.
 * - class:   extra classes on the inner column, e.g. "pt-7" to change padding.
 * - stagger: "load" makes the column a motion group (`data-stagger="load"`)
 *            whose `data-reveal` children reveal 60ms apart on page load
 *            (src/scripts/motion.ts); the Hero uses it.
 *
 * The header is always a `data-reveal`; mark other content blocks
 * with `data-reveal` (and lists with `data-stagger`) where they are written.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  tone?: 'white' | 'gray';
  top?: 'flat' | 'rule' | 'sweep' | 'under';
  bottom?: 'flat' | 'sweep';
  gradient?: boolean;
  class?: string;
  stagger?: 'load';
}

const {
  id,
  eyebrow,
  title,
  tone = 'white',
  top = 'flat',
  bottom = 'flat',
  gradient = false,
  class: className,
  stagger,
} = Astro.props;
const tones = {
  white: 'bg-bg [--card:var(--color-surface)] [--tone:var(--color-bg)]',
  gray: 'bg-surface [--card:var(--color-bg)] [--tone:var(--color-surface)]',
};
/** Each top edge; sweeps overlap by their height (2rem, 4rem from md:). */
const tops = {
  flat: '',
  rule: 'border-t border-line',
  sweep: '-mt-8 rounded-tl-[100%_2rem] md:-mt-16 md:rounded-tl-[100%_4rem]',
  under: '-mt-8 md:-mt-16',
};
/** Top padding: 48px (64px from md:), plus room for the edge where it overlaps. */
const topPadding = {
  flat: 'pt-12 md:pt-16',
  rule: 'pt-12 md:pt-16',
  sweep: 'pt-16 md:pt-24',
  under: 'pt-20 md:pt-32',
};
/** Each bottom edge; one that overlaps the next band paints over it. */
const bottoms = {
  flat: '',
  sweep: 'z-10 rounded-br-[100%_2rem] md:rounded-br-[100%_4rem]',
};
---

<section
  id={id}
  data-tone={tone}
  class:list={[
    'relative',
    tones[tone],
    tops[top],
    bottoms[bottom],
    gradient &&
      'bg-[linear-gradient(to_bottom,var(--color-surface),color-mix(in_oklab,var(--color-surface)_40%,var(--color-line)))]',
  ]}
>
  <div
    class:list={[
      'relative mx-auto max-w-page px-5 pb-20 md:pb-32',
      topPadding[top],
      className,
    ]}
    data-stagger={stagger}
  >
    {
      title && (
        <header data-reveal class="mb-6">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          <h2 class="mt-2 text-2xl/snug font-bold tracking-[-0.02em] md:text-[32px]/snug">{title}</h2>
        </header>
      )
    }
    <slot />
  </div>
</section>
