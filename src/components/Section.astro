---
import Eyebrow from './Eyebrow.astro';

/*
 * One landing-page section: a full-width <section> with the 1px `line`
 * bottom rule, holding the centered ~680px column with section padding
 * (20px inline, 40px block). Children go in the default slot.
 *
 *   <Section id="courses" eyebrow="آموزش" title="دوره‌های من">…</Section>
 *
 * Props (all optional):
 * - id:      anchor id on the <section> (e.g. "courses", "tools").
 * - eyebrow: small label above the title (rendered only with it).
 * - title:   the section's h2.
 * - class:   extra classes on the inner column, e.g. "pt-7" to change padding.
 * - stagger: "load" makes the column a motion group (`data-stagger="load"`)
 *            whose `data-reveal` children reveal 60ms apart on page load
 *            (src/scripts/motion.ts); the Hero uses it.
 *
 * The header is always a `data-reveal`; mark other content blocks
 * with `data-reveal` (and lists with `data-stagger`) where they are written.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  class?: string;
  stagger?: 'load';
}

const { id, eyebrow, title, class: className, stagger } = Astro.props;
---

<section id={id} class="border-b border-line">
  <div class:list={['mx-auto max-w-page px-5 py-10', className]} data-stagger={stagger}>
    {
      title && (
        <header data-reveal class="mb-4.5">
          {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
          <h2 class="mt-1.5 text-xl/normal font-bold tracking-[-0.01em] md:text-2xl/normal">
            {title}
          </h2>
        </header>
      )
    }
    <slot />
  </div>
</section>
