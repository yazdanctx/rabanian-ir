---
import { getOrderedCollection } from '../content/ordered';
import { COPY } from '../site';
import MasterclassCard from './MasterclassCard.astro';
import Section from './Section.astro';

const courses = (await getOrderedCollection('courses')).map(({ data }) => data);
const masterclass = courses.find((course) => course.featured);
const { eyebrow, title } = COPY.courses;
---

<Section id="courses" eyebrow={eyebrow} title={title}>
  {masterclass && <MasterclassCard course={masterclass} />}
</Section>
