---
import type { CollectionEntry } from 'astro:content';
import { COPY, courseLink } from '../site';
import Price from './Price.astro';

/*
 * One Course on the Courses Rail: category label, title, one-line
 * description, then the «جزئیات ←» link (its `url`, else Support) and the
 * price in «میلیون». Fills its Rail cell; the footer row sits at the bottom.
 */
interface Props {
  course: CollectionEntry<'courses'>['data'];
}

const { course } = Astro.props;
const titleId = `course-${course.id}`;
---

<article
  class="lift flex h-full flex-col rounded-card border border-line bg-(--card) p-4 shadow-card"
>
  <p data-category class="mb-1.5 text-xs font-medium text-primary-text">{course.category}</p>
  <h3 id={titleId} class="mb-1.5 text-[15.5px]/normal font-bold">{course.title}</h3>
  <p class="mb-3.5 text-[13px]/[1.8] text-muted">{course.description}</p>
  <div class="mt-auto flex items-center justify-between">
    <a
      href={courseLink(course)}
      aria-describedby={titleId}
      class="text-[13px] font-semibold text-primary-text transition-colors hover:text-ink"
    >
      {COPY.courses.details}
    </a>
    <Price amount={course.priceMillionToman} unit={COPY.courses.priceUnit} />
  </div>
</article>
