---
import { getOrderedCollection } from '../content/ordered';
import { COPY } from '../site';
import CompanyLogo from './CompanyLogo.astro';
import Rail from './Rail.astro';
import Section from './Section.astro';

const brands = await getOrderedCollection('brands');
const { caption } = COPY.brands;
---

<Section tone="gray">
  <p data-reveal class="mb-5 text-center text-xs text-muted">{caption}</p>
  <Rail label={caption} cols={3} itemWidth="150px" autoScroll>
    {
      brands.map(({ id, data }) => (
        <li data-reveal class="flex min-h-18 flex-col items-center justify-center gap-2.5 rounded-card border border-line bg-(--card) px-3 py-4 text-center text-[13px] font-semibold">
          <CompanyLogo id={id} size={40} />
          {data.name}
        </li>
      ))
    }
  </Rail>
</Section>
