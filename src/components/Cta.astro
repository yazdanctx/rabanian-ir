---
import { COPY, LINKS } from '../site';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

/*
 * The call to action that opens the dark footer (Footer.astro): the Telegram
 * glyph in a tile, the Support eyebrow, the question, the line and the
 * «پیام در تلگرام» button. Colors are for the footer's `ink` (spec palette,
 * "on dark block").
 */
const { eyebrow, title, line, button } = COPY.cta;
---

<div data-cta data-reveal class="py-14 text-center md:py-20">
  <span
    aria-hidden="true"
    class="mx-auto mb-5 grid size-14 place-items-center rounded-2xl border border-white/10 bg-white/5 text-white"
  >
    <Icon name="telegram" size={26} />
  </span>
  <Eyebrow onInk class="justify-center">{eyebrow}</Eyebrow>
  <h2 class="mt-2 mb-2.5 text-2xl/snug font-bold tracking-[-0.02em] md:text-[32px]/snug">{title}</h2>
  <p class="mx-auto mb-6 max-w-[28rem] text-sm/[1.9] text-white/75">{line}</p>
  <a
    href={LINKS.support}
    class="inline-flex items-center gap-2 rounded-btn bg-primary px-6 py-3.25 text-sm font-semibold text-white lift hover:bg-primary-text"
  >
    <Icon name="telegram" size={17} />{button}
  </a>
</div>
