---
/*
 * Inline SVG glyphs from the design (24×24 box), coloured by `currentColor`
 * and always decorative (`aria-hidden`): name the link or button instead.
 * Add a glyph by adding a `paths` entry.
 *
 *   <Icon name="telegram" size={18} />
 */
import { STAR_PATH } from '../logo-mark';

const paths = {
  /** Logo mark; shared with the favicon and OG image (src/logo-mark.ts). */
  star: `<path d="${STAR_PATH}" fill="currentColor"/>`,
  telegram:
    '<path d="M21.5 4.3L2.8 11.5c-1 .4-1 1 0 1.3l4.8 1.5 1.8 5.8c.3.6.7.5 1.1.1l2.6-2.4 4.9 3.6c.6.3 1.1.1 1.3-.6l3-14c.2-.9-.3-1.4-1.1-1z" fill="currentColor"/>',
  /** Points left: "forward" in RTL. */
  chevron:
    '<path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>',
  linkedin:
    '<path d="M4.98 3.5A2.5 2.5 0 112.5 6 2.5 2.5 0 014.98 3.5zM3 8.5h4V21H3zM9 8.5h3.8v1.7h.05a4.2 4.2 0 013.75-2c4 0 4.75 2.65 4.75 6.1V21h-4v-5.5c0-1.3 0-3-1.85-3s-2.15 1.45-2.15 2.9V21H9z" fill="currentColor"/>',
  /** Footer credit. The design's path, mirrored to be symmetric about x=12. */
  heart:
    '<path d="M12 21s-7-4.5-9.5-9C.8 8.5 2.3 5 5.8 5c2.5 0 5.1 1.2 6.2 2.6C13.1 6.2 15.7 5 18.2 5c3.5 0 5 3.5 3.3 7C19 16.5 12 21 12 21z" fill="currentColor"/>',
  /** Testimonial cards. */
  quote:
    '<path d="M10 7H6a3 3 0 00-3 3v7h7v-7H6c0-1.1.9-2 2-2h2V7zm11 0h-4a3 3 0 00-3 3v7h7v-7h-4c0-1.1.9-2 2-2h2V7z" fill="currentColor"/>',
  person:
    '<circle cx="12" cy="8.5" r="3.6" stroke="currentColor" stroke-width="1.5"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  /** The Free Tool's mark: open to everyone. */
  check:
    '<path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>',
  /** Separator between inline items: a dot a third of `size` wide. */
  dot: '<circle cx="12" cy="12" r="4" fill="currentColor"/>',
  /** Locked Tool marker. */
  lock: '<rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 10V7a4 4 0 118 0v3" stroke="currentColor" stroke-width="1.7"/>',

  /* Tool glyphs, keyed by `icon` in tools.json (schema: toolIcon). */
  code: '<path d="M8 9l-3 3 3 3M16 9l3 3-3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  dictionary:
    '<path d="M5 4h10a3 3 0 013 3v13H8a3 3 0 00-3 3V4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 8h6M9 12h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
  prompts:
    '<path d="M12 3l2.2 5.5L20 10l-4.5 3.8L17 20l-5-3-5 3 1.5-6.2L4 10l5.8-1.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  books:
    '<path d="M5 5a2 2 0 012-2h11v16H7a2 2 0 00-2 2V5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  videos:
    '<rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M10 9l5 3-5 3V9z" fill="currentColor"/>',
  contracts:
    '<path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v4h4" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  snippets:
    '<path d="M8 9l-2 3 2 3M16 9l2 3-2 3M14 6l-4 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  downloads:
    '<path d="M12 3v11M8 10l4 4 4-4M5 20h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  /** Rendered width and height in px. */
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={className}
  set:html={paths[name]}
/>
