---
/*
 * Inline SVG glyphs from the design (24×24 box), coloured by `currentColor`
 * and always decorative (`aria-hidden`): name the link or button instead.
 * Add a glyph by adding a `paths` entry.
 *
 *   <Icon name="telegram" size={18} />
 */
const paths = {
  /** Logo mark; sits slightly high in its box, as in the design. */
  star: '<path d="M12 2.5l2 6.4 6.4 2-6.4 2-2 6.4-2-6.4-6.4-2 6.4-2z" fill="currentColor"/>',
  telegram:
    '<path d="M21.5 4.3L2.8 11.5c-1 .4-1 1 0 1.3l4.8 1.5 1.8 5.8c.3.6.7.5 1.1.1l2.6-2.4 4.9 3.6c.6.3 1.1.1 1.3-.6l3-14c.2-.9-.3-1.4-1.1-1z" fill="currentColor"/>',
  /** Points left: "forward" in RTL. */
  chevron:
    '<path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>',
  person:
    '<circle cx="12" cy="8.5" r="3.6" stroke="currentColor" stroke-width="1.5"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  /** Rendered width and height in px. */
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={className}
  set:html={paths[name]}
/>
