---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { COPY, courseLink } from '../site';
import Price from './Price.astro';
// To change the banner, replace this file (16:9, at least 1600px wide). Keep
// the path and name: nothing else needs editing. Until Amin's banner arrives
// it is a neutral placeholder.
import banner from '../assets/images/masterclass-banner.jpg';

/*
 * The Masterclass: the one Course shown with a banner. The 16:9 banner fills
 * `[data-banner]` under the badge; it is below the fold, so it loads lazily.
 */
interface Props {
  course: CollectionEntry<'courses'>['data'];
}

const { course } = Astro.props;
---

<article
  data-masterclass
  class="overflow-hidden rounded-card border border-line bg-(--card) shadow-card"
>
  <div data-banner class="relative flex aspect-video items-end justify-end bg-surface p-3">
    <Picture
      src={banner}
      alt={COPY.courses.bannerAlt}
      formats={['avif', 'webp']}
      widths={[390, 680, 1024, 1360]}
      sizes="(min-width: 680px) 640px, calc(100vw - 40px)"
      width={680}
      height={383}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 size-full object-cover"
    />
    {
      course.badge && (
        <span class="relative rounded-full bg-primary px-2.5 py-1.25 text-[11px] font-semibold text-on-primary">
          {course.badge}
        </span>
      )
    }
  </div>
  <div class="px-4 pt-3.5 pb-4">
    <h3 class="mb-1.5 text-[15.5px]/normal font-bold">{course.title}</h3>
    <p class="text-[13px]/[1.8] text-muted">{course.description}</p>
    <div class="mt-3 flex items-center justify-between">
      <a
        href={courseLink(course)}
        class="rounded-btn bg-primary px-4 py-2.25 text-[13px] font-semibold text-on-primary transition-colors hover:bg-primary-hover"
      >
        {COPY.courses.enroll}
      </a>
      <Price amount={course.priceMillionToman} unit={COPY.courses.priceUnitLong} large />
    </div>
  </div>
</article>
