---
import type { CollectionEntry } from 'astro:content';
import { COPY, courseLink } from '../site';

/*
 * The Masterclass: the one Course shown with a banner. The banner is a
 * neutral `primary-soft` slot until ticket 06 puts its <Picture> in
 * `[data-banner]`, under the badge.
 */
interface Props {
  course: CollectionEntry<'courses'>['data'];
}

const { course } = Astro.props;
---

<article
  data-masterclass
  class="overflow-hidden rounded-card border border-line bg-surface shadow-card"
>
  <div data-banner class="relative flex h-27.5 items-end justify-end bg-primary-soft p-3">
    {
      course.badge && (
        <span class="relative rounded-full bg-primary px-2.5 py-1.25 text-[11px] font-semibold text-white">
          {course.badge}
        </span>
      )
    }
  </div>
  <div class="px-4 pt-3.5 pb-4">
    <h3 class="mb-1.5 text-[15.5px]/normal font-bold">{course.title}</h3>
    <p class="text-[13px]/[1.8] text-muted">{course.description}</p>
    <div class="mt-3 flex items-center justify-between">
      <a
        href={courseLink(course)}
        class="rounded-btn bg-primary px-4 py-2.25 text-[13px] font-semibold text-white transition-colors hover:bg-primary-text"
      >
        {COPY.courses.enroll}
      </a>
      <p data-price>
        <b class="text-xl font-bold">{course.priceMillionToman}</b>{' '}
        <span class="text-xs text-muted">{COPY.courses.priceUnitLong}</span>
      </p>
    </div>
  </div>
</article>
