---
import { LOGO_MARK_SVG } from '../logo-mark';
import { SITE } from '../site';

/*
 * The logo: the academy's «>_» mark (src/logo-mark.ts, also the favicon) as a
 * 30px tile + «آکادمی ربانیان», linking to the top. The mark is inline, so it
 * costs no request, and decorative: the text names the link.
 */
---

<a href="#top" class="inline-flex items-center gap-2.25 rounded-btn text-[15px] font-bold focus-ring">
  <span data-logo-mark aria-hidden="true" class="size-7.5 shrink-0 [&>svg]:size-full" set:html={LOGO_MARK_SVG} />
  <span>{SITE.brand}</span>
</a>
