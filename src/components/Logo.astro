---
import { Picture } from 'astro:assets';
import { SITE } from '../site';
// The same file as the Hero photo (see ProfilePhoto.astro): replacing it
// updates both.
import profile from '../assets/images/profile.jpg';

/*
 * The logo: Amin's photo in a 30px circle + «آکادمی ربانیان». On the home
 * page it links to the top; on any other page (the HTML Editor) it links home.
 */
const href = Astro.url.pathname === '/' ? '#top' : '/';
---

<a
  href={href}
  class="inline-flex items-center gap-2.25 rounded-btn text-[15px] font-bold focus-ring"
>
  <Picture
    src={profile}
    alt=""
    formats={['avif', 'webp']}
    widths={[30, 60, 90]}
    sizes="30px"
    width={30}
    height={30}
    loading="eager"
    decoding="async"
    class="size-7.5 rounded-full border border-line bg-surface object-cover"
  />
  <span>{SITE.brand}</span>
</a>
