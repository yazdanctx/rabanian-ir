---
import { getOrderedCollection } from '../content/ordered';
import { COPY } from '../site';
import CompanyLogo from './CompanyLogo.astro';
import Gallery from './Gallery.astro';
import Section from './Section.astro';

/*
 * About, with the Brands in it: the heading, the self-scrolling photo strip,
 * the story, then the Brands as one still list card: the caption as its
 * header row, then a row per Brand (logo and name), divided by hairlines. The
 * card reveals as one block.
 */
const brands = await getOrderedCollection('brands');
const { eyebrow, title, paragraph } = COPY.about;
const { caption } = COPY.brands;
---

<Section id="about" eyebrow={eyebrow} title={title} tone="gray" top="under" fade>
  <Gallery />
  <p data-reveal class="mb-8 text-[15px]/[2.1] text-muted md:text-base/[2.1]">
    {
      paragraph.map((part) =>
        typeof part === 'string' ? part : <strong class="font-semibold text-ink">{part.brand}</strong>,
      )
    }
  </p>
  <div data-brand-wall data-reveal class="overflow-hidden rounded-card border border-line bg-(--card) shadow-card">
    <p
      id="brands-caption"
      class="flex items-center gap-2 border-b border-line bg-surface px-4.5 py-3.5 text-[12.5px] font-medium text-muted before:h-0.5 before:w-4.5 before:flex-none before:rounded-full before:bg-primary md:text-[13px]"
    >
      {caption}
    </p>
    <ul aria-labelledby="brands-caption" class="divide-y divide-line">
      {
        brands.map(({ id, data }) => (
          <li class="flex items-center gap-3.5 px-4.5 py-3 text-[14.5px] font-semibold">
            <CompanyLogo id={id} size={38} />
            {data.name}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
