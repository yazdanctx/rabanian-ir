---
import { COPY, SITE } from '../site';
import Cta from './Cta.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

/*
 * The end of every content page, and its one dark surface: a single `ink`
 * block holding the call to action, then the logo, the one-line bio, the
 * links and the credit. Place it right after <main>; the full-screen HTML
 * Editor has none. Like the bands above it, it rises into the last one with
 * a domed top edge (see Section.astro); its overflow clip trims the grid to
 * the dome. Behind it, a barely-there grid of 64px squares keeps the ink calm
 * and even: one SVG pattern cell repeated, hairlines at 3.5% white, no
 * gradients. Each cell's lines are on its far edges, so none runs along the
 * footer's top edge.
 */
const { links, creditBefore, creditHeart, creditAfter } = COPY.footer;
const CELL = 64;
---

<footer
  class="relative isolate -mt-10 overflow-hidden rounded-t-[50%_2.5rem] bg-ink text-white md:-mt-16 md:rounded-t-[50%_4rem]"
>
  <svg aria-hidden="true" class="absolute inset-0 -z-10 size-full">
    <defs>
      <pattern id="footer-grid" width={CELL} height={CELL} patternUnits="userSpaceOnUse">
        <path d={`M${CELL - 0.5} 0V${CELL}M0 ${CELL - 0.5}H${CELL}`} stroke="rgb(255 255 255 / 0.035)" fill="none" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#footer-grid)" />
  </svg>
  <div class="mx-auto max-w-page px-5">
    <Cta />
    <div class="pt-2 pb-8">
      <Logo />
      <p class="mt-4 mb-5 text-[13px]/[2] text-white/70">{SITE.footerBio}</p>
      <nav>
        <ul class="flex flex-col gap-2 md:flex-row">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex items-center gap-2.5 rounded-btn border border-white/10 bg-white/5 px-4 py-3 text-sm md:py-2.5 lift hover:border-primary-on-ink hover:text-primary-on-ink"
                >
                  <Icon name={link.icon} size={16} class="text-white/60" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="mt-7 flex items-center justify-center gap-1.5 border-t border-white/10 pt-5 text-xs text-white/60">
        {creditBefore}{' '}
        <Icon name="heart" size={14} class="text-primary" /><span class="sr-only">{creditHeart}</span>{' '}
        {creditAfter}
      </p>
    </div>
  </div>
</footer>
