---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Brands from '../components/Brands.astro';
import Testimonials from '../components/Testimonials.astro';
import Resume from '../components/Resume.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="امین ربانیان | آموزش هوش مصنوعی"
  description="امین ربانیان، متخصص هوش مصنوعی و مدیریت محصول؛ دوره‌های آموزش هوش مصنوعی، برنامه‌نویسی و طراحی سایت."
>
  <TopBar />
  <main>
    <Hero />
    <About />
    <Brands />
    <Testimonials />
    <Resume />
    <Cta />
  </main>
  <Footer />
</Base>
